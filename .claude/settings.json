{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(gofmt -l:*)",
      "Bash(npm --prefix web test:*)",
      "Bash(npm --prefix web run build:*)",
      "Bash(npm --prefix web run lint:*)",
      "Bash(node --test scripts/rename.test.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
